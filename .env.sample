# Environment
APP__ENV=local

# API Configuration
APP__API__TITLE=FB Spy API
APP__API__PORT=8000
APP__API__ALLOWED_HOSTS=["*"]
FRONTEND_PORT=8080

# JWT Configuration
APP__JWT__SECRET_KEY=your-secret-key-here
APP__JWT__ALGORITHM=HS256
APP__JWT__ACCESS_TOKEN_EXPIRES_IN_MINUTES=30
APP__JWT__REFRESH_EXPIRES_IN_MINUTES=1440

# Protected media storage (set backend=s3 only in the backend environment)
APP__MEDIA__BACKEND=local
APP__MEDIA__ENDPOINT_URL=
APP__MEDIA__REGION=
APP__MEDIA__BUCKET=
APP__MEDIA__ACCESS_KEY_ID=
APP__MEDIA__SECRET_ACCESS_KEY=
APP__MEDIA__READ_ONLY_SECRET_ACCESS_KEY=
APP__MEDIA__OBJECT_PREFIX=ads
APP__MEDIA__PUBLIC_PATH=/media
APP__MEDIA__SIGNING_SECRET=replace-with-an-independent-random-secret-at-least-32-chars
APP__MEDIA__SIGNED_URL_TTL_SECONDS=2592000
APP__MEDIA__UPLOAD_CONCURRENCY=4
APP__MEDIA__MULTIPART_THRESHOLD_MB=100
APP__MEDIA__MULTIPART_CHUNK_MB=16
APP__MEDIA__MULTIPART_CONCURRENCY=2

# Initial admin seeded by the user_roles migration (read at migrate time only)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me

# PostgreSQL Configuration
APP__POSTGRES__USER=postgres
APP__POSTGRES__PASSWORD=postgres
APP__POSTGRES__HOST=localhost
APP__POSTGRES__PORT=5432
APP__POSTGRES__DB=app

# Redis Configuration
APP__REDIS__HOST=localhost
APP__REDIS__PORT=6379
APP__REDIS__DB=0

# Playwright Configuration
APP__PLAYWRIGHT__ENABLED=false
APP__PLAYWRIGHT__HEADLESS=true
APP__PLAYWRIGHT__MAX_BROWSERS=2
APP__PLAYWRIGHT__CONTEXTS_PER_BROWSER=5

# Facebook collector
APP__FACEBOOK__DATA_DIR=storage/facebook
APP__FACEBOOK__RUNNER_OUT_DIR=storage/facebook/runs
APP__FACEBOOK__RUNNER_MODULE=app.services.facebook_runner
APP__FACEBOOK__OCTO_HOST=127.0.0.1
APP__FACEBOOK__OCTO_PORT=58888
APP__FACEBOOK__OCTO_PROFILE_UUID=replace-with-octo-profile-uuid
APP__FACEBOOK__OCTO_HEADLESS=false
APP__FACEBOOK__OCTO_API_TOKEN=
APP__FACEBOOK__OCTO_SEARCH_TAGS=
APP__FACEBOOK__DEFAULT_MINUTES=10
APP__FACEBOOK__DEFAULT_RESOLVE_MAX=200
APP__FACEBOOK__DEFAULT_COLLECT_SCROLLS=10000
APP__FACEBOOK__DEFAULT_SCROLL_PX=520
APP__FACEBOOK__MEDIA_MOUNT_PATH=/media
APP__FACEBOOK__RELEVANCE_FILTER_ENABLED=false
APP__FACEBOOK__RELEVANCE_FILTER_CONCURRENCY=4
APP__FACEBOOK__RELEVANCE_FILTER_TASKIQ_ENABLED=true
APP__FACEBOOK__RELEVANCE_FILTER_TASK_TIMEOUT_SECONDS=45
APP__FACEBOOK__RELEVANCE_FILTER_TASK_RETRIES=1
APP__FACEBOOK__STREAMING_IMPORT_ENABLED=true
APP__FACEBOOK__STREAMING_IMPORT_POLL_SECONDS=1
APP__FACEBOOK__LANDING_ARCHIVE_ENABLED=true
APP__FACEBOOK__LANDING_ARCHIVE_TIMEOUT_SECONDS=20
APP__FACEBOOK__LANDING_ARCHIVE_MAX_RESOURCES=120
APP__FACEBOOK__VIDEO_RECORDING_ENABLED=true
APP__FACEBOOK__VIDEO_RECORDING_MAX_SECONDS=30
APP__FACEBOOK__VIDEO_RECORDING_FPS=8
FACEBOOK_ORCHESTRATOR_MAX_PARALLEL=5
FACEBOOK_ORCHESTRATOR_COLLECT_MINUTES=15
FACEBOOK_ORCHESTRATOR_PROFILE_REST_MINUTES=45
FACEBOOK_ORCHESTRATOR_RECOVERY_BURST_CYCLES=3
FACEBOOK_ORCHESTRATOR_RECOVERY_BURST_REST_MINUTES=0
FACEBOOK_ORCHESTRATOR_INFRASTRUCTURE_RETRY_MINUTES=5
FACEBOOK_ISOLATED_RESOLUTION_TIMEOUT_SECONDS=900
FACEBOOK_ENRICHMENT_TIMEOUT_SECONDS=1200
FACEBOOK_CALIBRATION_TARGET_GOAL=10
FACEBOOK_CALIBRATION_LOW_RELEVANCE_TARGET_GOAL=30
FACEBOOK_CALIBRATION_RECOVERY_TARGET_GOAL=40
FACEBOOK_CALIBRATION_RECOVERY_TARGET_LIMIT=50
FACEBOOK_CALIBRATION_PAGE_TIMEOUT_SECONDS=45
FACEBOOK_CALIBRATION_LANDING_VIEW_SECONDS=45
FACEBOOK_CALIBRATION_LANDING_TIMEOUT_SECONDS=20
FACEBOOK_CALIBRATION_SESSION_MINUTES=15
FACEBOOK_CALIBRATION_FUNNEL_TARGET_GOAL=3
FACEBOOK_CALIBRATION_PRELANDER_MAX_SCROLLS=12
FACEBOOK_CALIBRATION_QUIZ_MAX_QUESTIONS=10
# Keep disabled unless every submit domain is authorized for end-to-end testing.
FACEBOOK_CALIBRATION_OFFER_SUBMIT_MODE=disabled
# Comma-separated exact domains; subdomains are accepted, lookalike suffixes are not.
FACEBOOK_CALIBRATION_OFFER_SUBMIT_ALLOW_DOMAINS=
# Private JSON; supports profiles -> UUID, countries -> name, and default records.
FACEBOOK_CALIBRATION_OFFER_IDENTITY_JSON=
FACEBOOK_CALIBRATION_OFFER_SUCCESS_WAIT_SECONDS=20
FACEBOOK_CALIBRATION_MAX_RETAINED_OFFER_TABS=6
FACEBOOK_CALIBRATION_MIN_TARGETS=2
FACEBOOK_CALIBRATION_COOLDOWN_HOURS=1
FACEBOOK_SOFT_DROP_CALIBRATION_WINDOWS=2
FACEBOOK_WATCH_DROP_RATIO=0.95
FACEBOOK_IMMEDIATE_DROP_RATIO=0.70
FACEBOOK_MINIMUM_HEALTHY_RELEVANT_RATE=0.75
FACEBOOK_MINIMUM_HEALTHY_RELEVANT_ADS=15
FACEBOOK_ZERO_ADS_WINDOWS=1
FACEBOOK_ABSOLUTE_LOW_ADS_WINDOWS=2
FACEBOOK_ABSOLUTE_LOW_ADS_PER_HOUR=12
FACEBOOK_ZERO_ADS_CALIBRATION_COOLDOWN_MINUTES=30
FACEBOOK_ZERO_ADS_CALIBRATION_BURST_LIMIT=8
FACEBOOK_ZERO_ADS_CALIBRATION_BACKOFF_HOURS=2
FACEBOOK_CALIBRATION_RETRY_COOLDOWN_HOURS=0.5
FACEBOOK_MAINTENANCE_CALIBRATION_HOURS=3
FACEBOOK_MAINTENANCE_MIN_VALID_WINDOWS=2
FACEBOOK_CALIBRATION_MAX_PER_24H=36
FACEBOOK_CALIBRATION_REACTION_RATE=0.65
FACEBOOK_CALIBRATION_FOLLOW_RATE=0.20
FACEBOOK_CALIBRATION_COMMENT_EVERY=0
FACEBOOK_CALIBRATION_MAX_REACTIONS=6
FACEBOOK_CALIBRATION_MAX_FOLLOWS=2
FACEBOOK_CALIBRATION_MAX_COMMENTS=0
FACEBOOK_CALIBRATION_MIN_INTERACTIONS=1
FACEBOOK_CALIBRATION_COMMENT_TEMPLATE=👍

# Gemini relevance analysis
APP__GEMINI__API_KEY=
APP__GEMINI__MODEL=gemini-2.5-flash
